# ---------------------------------------------------------------------------
# MRTC Calendar - environment configuration
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

# HTTP port for the Calendar API (and the built SPA in production)
PORT=4000

# node environment: development | production
NODE_ENV=development

# Secret used to sign session cookies. MUST be changed for any real deployment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-in-production-please-use-a-long-random-value

# Where the SQLite database and uploaded attachments live.
DATA_DIR=./data

# Comma separated list of origins allowed to call the API with credentials.
# The Vite dev server runs on 5173 by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed credentials. Used ONLY the first time the database is created.
SEED_SUPER_ADMIN_NAME=MRTC Super Admin
SEED_SUPER_ADMIN_EMAIL=admin@mrtc.edu
SEED_SUPER_ADMIN_PASSWORD=mrtc-super-admin

SEED_STAFF_ONE_NAME=Staff Admin One
SEED_STAFF_ONE_EMAIL=staff1@mrtc.edu
SEED_STAFF_ONE_PASSWORD=mrtc-staff-one

SEED_STAFF_TWO_NAME=Staff Admin Two
SEED_STAFF_TWO_EMAIL=staff2@mrtc.edu
SEED_STAFF_TWO_PASSWORD=mrtc-staff-two

# Set to "false" to skip the demo events/responsibilities on first boot.
SEED_DEMO_DATA=true
