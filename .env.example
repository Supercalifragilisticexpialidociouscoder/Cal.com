# ---------------------------------------------------------------------------
# Infin8 Calendar - environment configuration
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

# HTTP port for the Calendar API (and the built SPA in production)
PORT=4000

# node environment: development | production
NODE_ENV=development

# Secret used to sign session cookies. MUST be changed for any real deployment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-in-production-please-use-a-long-random-value

# Where the SQLite database and uploaded attachments live.
DATA_DIR=./data

# Comma separated list of origins allowed to call the API with credentials.
# The Vite dev server runs on 5173 by default.
#
# In a split deployment this MUST include the address the browser uses - the
# Cloudflare Pages URL - because the proxy forwards the browser's Origin header
# and the API checks it. For example:
#   CORS_ORIGINS=https://infin8-calendar.pages.dev,https://calendar.yourdomain.edu
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Administrator accounts.
#
# Used ONLY the first time the database is created. Afterwards the accounts
# exist in the database and these values are ignored; change a password from
# Account settings in the app, not here.
#
# NEVER commit real passwords. This file is a template in a public repository.
# Set the three below in your own .env locally, and in the host's environment
# (Render: Environment > Environment Variables) in production. With none set,
# development generates throwaway passwords and prints them once at startup,
# and production refuses to create the accounts at all.
# ---------------------------------------------------------------------------

SEED_SUPER_ADMIN_NAME=MRTC Admin
SEED_SUPER_ADMIN_EMAIL=mrtc@admin.cal8
SEED_SUPER_ADMIN_PASSWORD=

SEED_STAFF_ONE_NAME=Abhi
SEED_STAFF_ONE_EMAIL=abhi@admin.cal8
SEED_STAFF_ONE_PASSWORD=

SEED_STAFF_TWO_NAME=Sagar
SEED_STAFF_TWO_EMAIL=sagar@admin.cal8
SEED_STAFF_TWO_PASSWORD=

# Set to "false" to skip the demo events/responsibilities on first boot.
SEED_DEMO_DATA=true
